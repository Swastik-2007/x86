{
  "manifest_version": 3,
  "name": "Manuscript — Google Meet Intelligence",
  "version": "6.0.0",
  "description": "Record Google Meet tab audio and microphone, capture live notes, and send meetings to your Manuscript web server.",
  "short_name": "Manuscript",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Manuscript"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "overlay/overlay.html",
        "overlay/overlay.css",
        "overlay/overlay.js",
        "fonts/DMSans-Variable.woff2"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ]
}
