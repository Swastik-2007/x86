{
  "name": "manuscript",
  "version": "6.0.1",
  "description": "Manuscript — browser-first meeting intelligence with Google Meet capture, structured decisions, action tracking, Notion sync, and Obsidian export.",
  "keywords": ["ai-meeting-notes", "meeting-transcription", "decision-log", "action-tracker", "google-meet", "chrome-extension", "notion", "obsidian", "web-app", "node-api"],
  "homepage": "https://aslahtp.github.io/meetmind/",
  "bugs": { "url": "https://github.com/aslahtp/meetmind/issues" },
  "license": "GPL-3.0-only",
  "repository": { "type": "git", "url": "https://github.com/aslahtp/meetmind.git" },
  "main": "src/server/index.js",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:renderer": "vite --host 0.0.0.0",
    "dev:server": "node src/server/index.js",
    "start": "node src/server/index.js",
    "prebuild": "pnpm run build:ext",
    "build": "vite build",
    "build:renderer": "vite build",
    "build:ext": "node scripts/build-extension.js",
    "preview": "vite preview --host 0.0.0.0",
    "generate-icons": "node scripts/generate-icons.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@google/generative-ai": "^0.24.1",
    "@notionhq/client": "^2.3.0",
    "assemblyai": "^4.41.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "googleapis": "^176.0.0",
    "ical.js": "^2.2.1",
    "lucide-react": "^1.61.0",
    "multer": "^2.0.2",
    "partial-json": "^0.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remend": "^1.4.0",
    "sql.js": "^1.15.1",
    "uuid": "^14.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
